{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/declarations/**",
    "**/dist/**",
    "**/lib/**",
    "**/node_modules/**",
    "packages/web3.js/src/__generated__/**",
    "packages/web3.js/test/dist/**"
  ],
  "jsxSingleQuote": false,
  "overrides": [
    {
      "files": ["*.yaml", "*.yml"],
      "options": { "tabWidth": 2 }
    }
  ],
  "printWidth": 120,
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": true,
  "sortImports": true,
  "tabWidth": 4,
  "useTabs": false
}
