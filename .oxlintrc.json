{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@solana-config/oxc/oxlint.json"],
  "ignorePatterns": [
    "**/declarations/**",
    "**/dist/**",
    "**/lib/**",
    "**/node_modules/**",
    "packages/web3.js/src/__generated__/**",
    "packages/web3.js/test/dist/**"
  ],
  "options": { "typeAware": true },
  "overrides": [
    // Rules the existing packages do not yet satisfy. Oxfmt and Oxlint are
    // adopted here with the repository's established code style so that this
    // change is limited to tooling; each relaxation below is lifted, and the
    // resulting code churn absorbed, in follow-up work.
    {
      "files": ["examples/**", "packages/**"],
      "rules": {
        "no-unused-expressions": "off",
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_",
            "destructuredArrayIgnorePattern": "^_",
            "varsIgnorePattern": "^_"
          }
        ],
        "sort-keys": "off",
        "typescript/await-thenable": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-duplicate-type-constituents": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-redundant-type-constituents": "off",
        "typescript/no-wrapper-object-types": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "typescript/restrict-plus-operands": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/return-await": "off",
        "typescript/unbound-method": "off",
        "unicorn/no-await-in-promise-methods": "off",
        "unicorn/no-new-array": "off",
        "unicorn/no-thenable": "off",
        "unicorn/no-useless-fallback-in-spread": "off",
        "unicorn/no-useless-spread": "off"
      }
    },
    // Test suites use `async` stubs and mock implementations that never
    // await, which is idiomatic for the mocking libraries in use here.
    {
      "files": ["**/__tests__/**", "**/test/**"],
      "rules": {
        "typescript/require-await": "off"
      }
    }
  ]
}
