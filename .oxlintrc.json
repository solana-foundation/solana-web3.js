{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@solana-config/oxc/oxlint.json"],
  "ignorePatterns": [
    "**/declarations/**",
    "**/dist/**",
    "**/lib/**",
    "**/node_modules/**",
    "packages/web3.js/src/__generated__/**",
    "packages/web3.js/test/dist/**"
  ],
  "options": { "typeAware": true },
  "plugins": ["import", "oxc", "typescript", "unicorn"],
  "rules": {
    "import/first": "error",
    "import/no-commonjs": "error",
    "typescript/prefer-promise-reject-errors": "off",
    "typescript/unbound-method": "off"
  },
  "overrides": [
    {
      "files": ["packages/web3.js/**"],
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_",
            "destructuredArrayIgnorePattern": "^_",
            "varsIgnorePattern": "^_"
          }
        ],
        "sort-keys": "off",
        "typescript/no-duplicate-type-constituents": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-redundant-type-constituents": "off"
      }
    },
    {
      "files": ["packages/web3.js/test/**"],
      "rules": {
        "no-unused-expressions": "off",
        "typescript/no-base-to-string": "off",
        "unicorn/no-thenable": "off"
      }
    },
    {
      "files": ["packages/wallet-adapter/src/__tests__/**"],
      "rules": {
        "typescript/require-await": "off"
      }
    }
  ]
}
