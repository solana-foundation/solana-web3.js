{
    "name": "@solana/web3.js",
    "version": "3.0.0-rc.2",
    "description": "Solana Javascript API",
    "keywords": [
        "api",
        "blockchain",
        "solana",
        "web3"
    ],
    "homepage": "https://solana.com/",
    "bugs": {
        "url": "http://github.com/solana-foundation/solana-web3.js.git/issues"
    },
    "license": "MIT",
    "author": "Solana Foundation",
    "repository": {
        "type": "git",
        "url": "https://github.com/solana-foundation/solana-web3.js.git",
        "directory": "packages/web3.js"
    },
    "files": [
        "/lib"
    ],
    "main": "lib/index.cjs.js",
    "module": "lib/index.esm.js",
    "browser": {
        "./lib/index.cjs.js": "./lib/index.browser.cjs.js",
        "./lib/index.esm.js": "./lib/index.browser.esm.js"
    },
    "types": "lib/index.d.ts",
    "react-native": "lib/index.native.js",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "compile:docs": "typedoc --treatWarningsAsErrors",
        "compile:js": "NODE_ENV=production rollup -c",
        "compile:typedefs": "./scripts/typegen.sh",
        "build:fixtures": "set -ex; ./test/fixtures/noop-program/build.sh",
        "dev": "NODE_ENV=development rollup -c --watch",
        "prepack": "NODE_ENV=production rollup -c && ./scripts/typegen.sh && pnpm test:smoke",
        "prepublishOnly": "pnpm pkg delete devDependencies",
        "test:lint": "oxlint src/ test/",
        "test:lint:fix": "oxlint --fix src/ test/",
        "test:live": "TEST_LIVE=1 pnpm run test:unit",
        "test:live-with-test-validator": "start-server-and-test './scripts/start-shared-test-validator.sh' http://127.0.0.1:8899/health test:live",
        "test:live-with-test-validator:setup": "./scripts/setup-test-validator.sh",
        "test:prettier": "oxfmt --check src/ test/",
        "test:prettier:fix": "oxfmt src/ test/",
        "test:smoke": "node scripts/smoke-test.mjs",
        "test:typecheck": "tsc --noEmit",
        "test:unit": "NODE_ENV=test NODE_OPTIONS='--import tsx' mocha './test/**/*.test.ts'"
    },
    "dependencies": {
        "@noble/curves": "^1.4.2",
        "@noble/hashes": "^1.4.0",
        "@solana-program/address-lookup-table": "catalog:",
        "@solana-program/compute-budget": "catalog:",
        "@solana-program/loader-v3": "catalog:",
        "@solana-program/stake": "catalog:",
        "@solana-program/system": "catalog:",
        "@solana/assertions": "catalog:",
        "@solana/fast-stable-stringify": "catalog:",
        "@solana/kit": "catalog:",
        "@solana/rpc-spec-types": "catalog:",
        "@solana/signers": "catalog:"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@solana-program/token": "catalog:",
        "@solana/addresses": "catalog:",
        "@solana/rpc-subscriptions-api": "catalog:",
        "@solana/rpc-types": "catalog:",
        "@types/chai-as-promised": "^8.0.0",
        "@types/mocha": "^10.0.6",
        "@types/node": "^22.19.7",
        "@types/sinon": "^17.0.3",
        "@types/sinon-chai": "^4.0.0",
        "chai": "^5.1.1",
        "chai-as-promised": "^8.0.0",
        "esbuild": "^0.28.0",
        "mocha": "^11.0.1",
        "mockttp": "^4.2.3",
        "rollup": "^4.24.0",
        "rollup-plugin-dts": "^6.1.1",
        "rollup-plugin-esbuild": "^6.2.1",
        "sinon": "^19.0.2",
        "sinon-chai": "^4.0.0",
        "start-server-and-test": "^2.1.5",
        "tsx": "^4.16.2",
        "typedoc": "^0.28.18",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=20.18.0"
    }
}
