{
  "name": "@solana/wallet-adapter-example",
  "version": "0.0.0",
  "private": true,
  "description": "Demo application for @solana/wallet-adapter",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
