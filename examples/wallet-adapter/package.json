{
  "name": "@solana/wallet-adapter-example",
  "version": "0.0.0",
  "private": true,
  "description": "Demo application for @solana/wallet-adapter",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "rm -rf .next out *.tsbuildinfo",
    "test:lint": "oxlint --deny-warnings app/ components/",
    "test:lint:fix": "oxlint --fix app/ components/",
    "test:format": "oxfmt --check app/ components/",
    "test:format:fix": "oxfmt app/ components/",
    "test:typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/kit": "catalog:",
    "@solana/wallet-adapter": "workspace:*",
    "@solana/web3.js": "workspace:*",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
