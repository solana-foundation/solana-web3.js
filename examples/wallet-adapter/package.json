    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.3",
    "typescript": "^5.9.3"
  }
